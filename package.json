{
  "name": "secret-service-platform",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=@secret-service/web",
    "dev:admin": "npm run dev --workspace=@secret-service/admin",
    "dev:customer": "npm run dev --workspace=@secret-service/customer",
    "build": "npm run build --workspaces --if-present",
    "build:web": "npm run build --workspace=@secret-service/web",
    "build:admin": "npm run build --workspace=@secret-service/admin",
    "build:customer": "npm run build --workspace=@secret-service/customer",
    "lint": "eslint apps packages --max-warnings=0",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "eslint": "^9.35.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0",
    "vite": "^7.1.4"
  },
  "dependencies": {
    "firebase": "^12.18.0"
  }
}
