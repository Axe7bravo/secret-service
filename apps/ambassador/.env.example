# Copy the same project's public Firebase web configuration used by the other apps.
# Never put Admin SDK credentials or server secrets here.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_DATA_SOURCE=firestore
# mock is honoured only by the development server; real ambassador Auth is required.
