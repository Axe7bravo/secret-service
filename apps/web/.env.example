# Real catalogue by default. Use mock explicitly for local fixtures.
# VITE_DATA_SOURCE takes precedence over legacy VITE_FIREBASE_MODE.
VITE_DATA_SOURCE=firestore
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Production requires the Customer app HTTPS origin, not the public site origin.
# Local example only: VITE_CUSTOMER_APP_URL=http://localhost:3002
# Omitted on a loopback dev host: use that host on port 3002.
# Remote/ngrok development requires the Customer app reachable HTTPS origin.
VITE_CUSTOMER_APP_URL=
